{
  "name": "south-park-bot",
  "version": "1.0.0",
  "description": "Бот для платформы MAX, выбирающий случайную серию South Park",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "dev:watch": "ts-node-dev --respawn --transpile-only src/index.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@maxhub/max-bot-api": "^0.2.5",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  },
  "private": true
}
